[Unit]
Description=MarianaBot Discord updates and research controls
After=network-online.target marianabot-terminal.service
Wants=network-online.target
Requires=marianabot-terminal.service
PartOf=marianabot-terminal.service
ConditionPathExists=%h/MarianaBot/discord.toml
ConditionPathExists=%h/MarianaBot/discord-token.txt
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=%h/MarianaBot
Environment=PATH=%h/.local/bin:%h/MarianaBot/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
UMask=0077
ExecStart=%h/MarianaBot/.venv/bin/python -m marianabot --no-update --service discord --config %h/MarianaBot/discord.toml --data-dir %h/.local/share/marianabot
# The runtime launcher may exit before its supervisor can clean up. Stop only
# the bot's tmux session; research workers remain owned by the terminal service.
ExecStop=-/usr/bin/tmux -L marianabot kill-session -t =mariana-discord
Restart=on-failure
RestartSec=30
TimeoutStopSec=30

[Install]
WantedBy=default.target
