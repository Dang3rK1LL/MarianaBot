Screen { background: #171d24; color: #d9e0e4; }
#masthead { height: 1; padding: 0 2; background: #202932; }
#brand { width: 1fr; height: 1; text-style: bold; }
#masthead Button { min-width: 8; width: auto; height: 1; margin: 0; border: none; background: #202932; color: #a6afb8; }
#masthead Button:hover, #masthead Button:focus { background: #92c9cb; color: #171d24; }
#status-line { height: 1; padding: 0 2; color: #a6afb8; }
#conversation { height: 1fr; padding: 1 3; scrollbar-size: 1 1; }
#welcome-title { height: auto; margin: 1 0; text-style: bold; }
#welcome-copy { height: auto; color: #a6afb8; }
#usage-strip { height: 5; padding: 0 2; }
#usage-strip Static { height: 1; }
#usage-scope { color: #a6afb8; }
.message { height: auto; margin-bottom: 2; }
.speaker { height: auto; margin-bottom: 1; color: #92c9cb; text-style: bold; }
.you .speaker { color: #d9e0e4; }
.system .speaker { color: #a6afb8; text-style: none; }
.system { border-left: solid #46545e; padding-left: 1; }
Markdown { background: transparent; padding: 0; margin: 0; height: auto; }
MarkdownH1, MarkdownH2, MarkdownH3 { margin-top: 1; margin-bottom: 1; padding: 0; border: none; color: #d9e0e4; text-style: bold; }
Collapsible { background: transparent; padding: 0; margin-top: 1; border: none; }
CollapsibleTitle { color: #92c9cb; }
#compose-box { height: auto; padding: 0 2; }
#composer { height: 3; border: solid #46545e; padding: 0 1; background: #202932; color: #d9e0e4; }
#composer:focus { border: solid #92c9cb; }
#suggestions { display: none; height: auto; max-height: 6; background: #202932; border: none; padding: 0 1; }
#suggestions > .option-list--option-highlighted { background: #92c9cb; color: #171d24; }
#input-tools { height: 1; }
#input-hint { width: 1fr; height: 1; color: #a6afb8; }
#send { height: 1; min-width: 8; background: #202932; color: #92c9cb; border: none; }
#send:hover, #send:focus { background: #92c9cb; color: #171d24; }
Footer { background: #171d24; color: #a6afb8; padding: 0 2; }
FooterKey { background: #171d24; }
FooterKey > .footer-key--key { background: #171d24; color: #a6afb8; text-style: none; }
FooterKey > .footer-key--description { background: #171d24; color: #a6afb8; }
FooterKey:hover > .footer-key--key, FooterKey:hover > .footer-key--description { background: #202932; color: #d9e0e4; }
ModalScreen { align: center middle; background: #171d24 80%; }
#dialog { width: 86; max-width: 94%; height: 85%; padding: 1 2; background: #202932; border: solid #92c9cb; }
#dialog VerticalScroll { height: 1fr; }
#dialog Button { height: 1; border: none; margin-top: 1; background: #202932; color: #92c9cb; }
#dialog Button:focus { background: #92c9cb; color: #171d24; }
.dialog-title { color: #d9e0e4; text-style: bold; margin-bottom: 1; }
#session-list { height: 1fr; margin-top: 1; background: #171d24; }
#model-dialog { width: 92; max-width: 94%; height: auto; max-height: 96%; padding: 1 2; background: #202932; border: solid #92c9cb; overflow-y: auto; }
#model-explanation, #current-models { height: auto; color: #a6afb8; }
.model-label { height: 1; margin-top: 1; }
.model-name { width: 1fr; height: 1; }
.effort-label { width: 18; height: 1; margin-left: 1; color: #a6afb8; }
.model-row { height: 3; }
.model-row Input { width: 1fr; border: solid #46545e; background: #171d24; }
.model-row Input:focus { border: solid #92c9cb; }
.model-row Select { width: 18; margin-left: 1; }
#model-error { height: auto; color: #dfba79; }
#model-actions { height: 1; margin-top: 1; }
#model-actions Button { height: 1; min-width: 9; width: auto; margin-right: 2; border: none; color: #92c9cb; background: #202932; }
#model-actions Button:hover, #model-actions Button:focus { color: #171d24; background: #92c9cb; }
